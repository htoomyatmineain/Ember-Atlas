{
  "name": "ember-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "import": "tsx --env-file-if-exists=.env scripts/import.ts",
    "publish:data": "tsx --env-file-if-exists=.env scripts/publish.ts",
    "check:rls": "tsx --env-file-if-exists=.env scripts/check-rls.ts",
    "smoke:api": "node scripts/smoke-api.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "csv-parse": "6.2.1",
    "leaflet": "1.9.4",
    "lucide-react": "1.64.0",
    "next": "16.4.3",
    "proj4": "2.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "type": "module"
}
